# Gmail SMTP Configuration
# Use App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Groww API (uses public endpoints)
GROWW_BASE_URL=https://groww.in/v1/api

# Monitoring interval in minutes
MONITOR_INTERVAL=5

# Portfolio config file path
PORTFOLIO_CONFIG=config/portfolio.json
TRIGGERS_CONFIG=config/triggers.json

# Weather API (Open-Meteo, no key required)
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# Climate trigger config file paths
CLIMATE_LOCATIONS_CONFIG=config/climateLocations.json
CLIMATE_TRIGGERS_CONFIG=config/climateTriggers.json

# Climate monitoring interval in minutes
CLIMATE_MONITOR_INTERVAL=30
