# Which AI writes the summaries: "ollama" (free, runs on your own Mac,
# no API key needed) or "anthropic" (paid, higher quality).
SUMMARIZER_PROVIDER=ollama

# --- ollama settings (used when SUMMARIZER_PROVIDER=ollama) ---
# Install Ollama from https://ollama.com, then run: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- anthropic settings (only used when SUMMARIZER_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/ (Settings > API Keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# When the automatic daily digest runs, in cron syntax.
# Default: every day at 21:00 (9 PM).
DIGEST_CRON=0 21 * * *

# Timezone the DIGEST_CRON time is interpreted in.
DIGEST_TIMEZONE=Asia/Kolkata

# The exact text you send yourself on WhatsApp to trigger an on-demand
# summary right now (case-insensitive).
ON_DEMAND_TRIGGER=/digest

# How many hours back to look on the very first run (before any digest
# has ever been sent). Later runs always summarize "since your last digest".
INITIAL_LOOKBACK_HOURS=24

# Max messages fetched per group per run (keeps things fast for very busy groups).
MAX_MESSAGES_PER_GROUP=300
